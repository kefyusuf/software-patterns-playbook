{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "payment-strategy/**/*.ts",
    "order-domain-event/**/*.ts",
    "notification-adapter/**/*.ts",
    "order-repository-dto/**/*.ts",
    "order-specification/**/*.ts",
    "checkout-chain/**/*.ts",
    "order-processing-state/**/*.ts"
  ]
}
